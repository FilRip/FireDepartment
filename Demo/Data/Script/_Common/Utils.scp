void PyroMove( EntityID Pyro )
{
	f32 x , y , x2 , y2 , Tempo , Dist;
	ENT_GetPosition( Pyro , x , y );

	x2 = RandomF32( SCR_GetVarF32("PyroXmin") , SCR_GetVarF32("PyroX") );
	y2 = RandomF32( SCR_GetVarF32("PyroYmin") , SCR_GetVarF32("PyroY") );

	IA_CmdMoveTo( Pyro , x2 , y2 , 1 );

//	Dist = ( (x2-x)*(x2-x) + (y2-y)*(y2-y) );
//	Tempo = Dist/2000000.0;

//	if ( RandomS32( 1 , 5 ) == 1 )
//		SCR_RunDelayedEntity("PyroTele" , 0.0 , Pyro );
//	else
//		SCR_RunDelayedEntity("PyroMove" , Tempo , Pyro );
		
	SCR_RunDelayedMultiArgs( "CheckPyroPos" , 3.0 , Pyro , 0 , 0 , x , y , "pipo" );
}

void CheckPyroPos( EntityID Pyro , s32 pipo , s32 pipo2 , f32 x , f32 y , mcString pipo3 )
{
	f32 xNew , yNew;
	ENT_GetPosition( Pyro , xNew , yNew );
	
	if ( ( x == xNew ) && ( y == yNew ) )
		SCR_RunDelayedEntity("PyroMove" , 1.0 , Pyro );
	else
		SCR_RunDelayedMultiArgs( "CheckPyroPos" , 3.0 , Pyro , 0 , 0 , xNew , yNew , "pipo" );
}

