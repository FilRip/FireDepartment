/* gestion widgets *******************************************************************************/
//- cree un widget
s32 createWDG (mcString wName, mcString wColor, mcString wText, f32 wDuree)
{
	SCR_SetVarString( wName+"_c" ,wColor);
	SCR_SetVarString( wName+"_t" ,wText);
	
	if ( wDuree<=0.0 )
	{
		SCR_SetVarS32( wName+"_b" ,1);
		SCR_SetVarF32( wName+"_d" ,1.0);
	}
	else
	{
		SCR_SetVarS32( wName+"_b" ,0);
		SCR_SetVarF32( wName+"_d" ,wDuree);
	}

	return (0);
}


//- affiche un widget
s32 displayWDG (mcString wName)
{
	SCR_RunDelayedArgs("displayWDG_C",0.0,0,0.0,wName);

	return (0);
}


//- efface un widget
s32 cleanWDG_ (mcString wName)
{
	SCR_RunDelayedArgs("cleanWDG_C",0.0,SCR_GetVarS32( wName+"_b" ) ,0.0,wName);

	return (0);
}


//- supprime un widget qui était en boucle
s32 stopWDG (mcString wName)
{
	SCR_SetVarS32( wName+"_b" ,0);

	return (0);
}


//- (private ne pas utiliser directement)
void cleanWDG_C (s32 enBoucle ,f32 pipo ,mcString wName)
{
	WDG_SetVisible( SCR_GetVarString( wName+"_c" ) ,0);
	SCR_SetVarS32("WarningOn",0);

	if ( enBoucle==1 )
		SCR_RunDelayedArgs("displayWDG_C",0.3,0,0.0,wName);
}


//- (private ne pas utiliser directement)
void displayWDG_C (s32 pipoI, f32 pipoF, mcString wName)
{
	if ( SCR_GetVarS32("WarningOn")==0 )
	{
		WDG_SetText( SCR_GetVarString( wName+"_c" ) , SCR_GetVarString( wName+"_t" ) );
		WDG_SetVisible( SCR_GetVarString( wName+"_c" ) ,1);
		
		SCR_SetVarS32("WarningOn",1);
		SCR_RunDelayedArgs("CleanWDG_C", SCR_GetVarF32( wName+"_d" ) , SCR_GetVarS32( wName+"_b" ) ,pipoF,wName);
	}
	else SCR_RunDelayedArgs("displayWDG_C",1.0,pipoI,pipoF,wName);
}

/* fin gestion widgets ***************************************************************************/


//- load an entity id in a global var
EntityID loadEI (mcString eName)
{
	EntityID ei;
	
	ei = ENT_FindByName(eName);
	SCR_SetVarS32(ename,ei);

	return (ei);
}


//-
EntityID getEI (mcString eName)
{
	return ( SCR_GetVarS32(eName) );
}


//- déplace l'unité jusqu'au wp
// ent peut être un groupe
s32 entMoveToWP (EntityID ent, EntityID wp)
{
	f32 x, y;
	
	ENT_GetPosition(wp,x,y);
	
	// si ent est un groupe
	if ( ENT_GetType(ent)==15 )
	{
		s32 i, l;
		l = ENT_GroupGetNbEntities(ent);
	
		for (i=0; i<l; i+=1)
		{
			IA_CmdMoveTo( ENT_GroupGetEntityAt(ent,i) ,x,y,1);
		}
	}
	else
	{
		IA_CmdMoveTo(ent,x,y,1);
	}

	return (0);
}


//- valeur absolue
f32 abs (f32 a)
{
	if ( a<0.0 )
	{	return (-a);
	}
	else
	{	return (a);
	}
}


//- conversion en s32
s32 castS32 (f32 f)
{
	s32 i;
	i = f;
	
	return (i);
}


//- conversion en f32
f32 castF32 (s32 i)
{
	f32 f;
	f = i;
	
	return (f);
}


//- simule un tableau, écriture
s32 tabSet (mcString tabName, s32 i, s32 value)
{
	SCR_SetVarS32( tabName+"["+i+"]" ,value);
	
	return (value);
}


//- simule un tableau, lecture
s32 tabGet (mcString tabName, s32 i)
{
	return ( SCR_GetVarS32( tabName+"["+i+"]" ) );
}


//- retourne vrai si 2 entités ont la même position
mcBool ENT_positionEqual (EntityID e1, EntityID e2)
{
	f32 xE, yE, xW, yW;
	f32 epsilon;
	epsilon = 0.1;
	
	ENT_GetPosition(e1,xE,yE);
	ENT_GetPosition(e2,xW,yW);
	
	return ( abs(xE-xW)<epsilon && abs(yE-yW)<epsilon );
}


void Tapis()
{
	f32 i, j , x, y;
	s32 HP ,group;

	group = ENT_GroupCreate("Tapis");

	for (i=450.0; i<50000.0; i+=900.0)
	{
		for (j=450.0; j<50000.0; j+=900.0)
		{
			HP = ENT_CreatePath( "Data/Design/Hotpoint/fireGrassMulti_LF.class" , "" , i , j , 10000.0 );
			ENT_GetPosition( HP , x ,y );
			ENT_SetPosition( HP , x+0.1 , y+0.5 );
			ENT_GroupAddEntity( group , HP );
		}
	}
	
	SCR_RunDelayed("Tapis2" , 1.0);
}

void Tapis2()
{
	s32 group, i, HP;
	f32 z;
	group = ENT_FindByName("Tapis");

	for ( i=0 ; i< ENT_GroupGetNbEntities( group ) ; i+=1 )
	{	
		HP = ENT_GroupGetEntityAt( group , i );	
		z = ENT_GetZ( HP );
		ENT_SetZ( HP , z+50.0 );
	}
}


