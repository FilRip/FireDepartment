void MouvementPipo( s32 Cible , s32 pipo2 , s32 pipo3 , f32 CoefX , f32 CoefY , f32 pipo4 , mcString pipo5 , mcString pipo6 , mcString pipo7 )
{
	f32 xC , yC;
	ENT_GetPosition( Cible , xC , yC );
	ENT_SetPosition( Cible , xC + CoefX , yC + CoefY );
}


void GoodOrientation()
{
	EntityID Group , Cible;
	s32 Nb , i;
	
	Group = ENT_FindByName("GroupTest");
	Nb = ENT_GroupGetNbEntities( Group );
	for ( i=0 ; i<Nb ; i+=1 )
	{
		Cible = ENT_GroupGetEntityAt( Group , i );
		ENT_SetPropertyValueF32( Cible , "ENTITY_POSITION" , "Orient_x" , 0.0 );
		ENT_SetPropertyValueF32( Cible , "ENTITY_POSITION" , "Orient_y" , 0.0 );
		ENT_SetPropertyValueF32( Cible , "ENTITY_POSITION" , "Orient_z" , 0.0 );
		ENT_SetPropertyValueF32( Cible , "ENTITY_POSITION" , "Local_X" , ENT_GetPropertyValueF32( Cible , "ENTITY_POSITION" , "Local_X") + 0.1 );

	}
}

