void Bonus_Calendar( EntityID Unit , EntityID Calendar , mcString pipo )
{
	s32 i;
	mcString Name;

	Name = ENT_GetName( Calendar );
	for ( i=1 ; i<=12 ; i+=1 )
	{
		if ( Name == "Calendar_"+i )
		{
			LEV_UnlockLP(i);
		}
			
	}

	// Fonction compteur de bonus à mettre
	// Message bonus découvert
	// Son de bonus
	SND_PlaySound2D("Calendar");
	SCR_RunDelayedEntity("Bonus_CalendarUpdate" , 2.0 , Calendar );
}

void Bonus_CalendarUpdate( EntityID Calendar )
{
	ENT_SetVisibility( Calendar , 0 );
}

