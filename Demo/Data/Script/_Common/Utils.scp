// FONCTIONS :

// f32 Distance( EntityID Ent1 , EntityID Ent2 )
// f32 DistY( EntityID Ent1 , EntityID Ent2 )
// f32 DistX( EntityID Ent1 , EntityID Ent2 )
// s32 GetNearestS32( f32 X )
// s32 RandomS32( s32 Min , s32 Max )
// s32 PlayParticle( s32 Cible , f32 ModeAndNum , mcString ParticleName )
// void PlayParticleDelayed( s32 Cible , f32 ModeAndNum , mcString ParticleName )
// s32 PlaySmallExplosion( s32 Cible , mcString ParticleName )


f32 Distance( EntityID Ent1 , EntityID Ent2 )
{
	f32 x1 , y1 , x2 , y2 , xDist , yDist , Dist ;
	ENT_GetPosition( Ent1 , x1 , y1 );
	ENT_GetPosition( Ent2 , x2 , y2 );

	xDist = x1 - x2;
	if ( xDist < 0.0 ) xDist = -xDist;

	yDist = y1 - y2;
	if ( yDist < 0.0 ) yDist = -yDist;

	Dist = xDist + yDist;
	return (Dist);
}

//---------------------------------------------------------------

f32 DistY( EntityID Ent1 , EntityID Ent2 )
{
	f32 x1 , y1 , x2 , y2 , Dist;
	ENT_GetPosition( Ent1 , x1 , y1 );
	ENT_GetPosition( Ent2 , x2 , y2 );

	Dist = y1 - y2;
	if ( Dist < 0.0 ) Dist = -Dist;
	return (Dist);
}

//---------------------------------------------------------------

f32 DistX( EntityID Ent1 , EntityID Ent2 )
{
	f32 x1 , y1 , x2 , y2 , Dist;
	ENT_GetPosition( Ent1 , x1 , y1 );
	ENT_GetPosition( Ent2 , x2 , y2 );

	Dist = x1 - x2;
	if ( Dist < 0.0 ) Dist = -Dist;
	return (Dist);
}

//---------------------------------------------------------------

f32 DistZ( EntityID Ent1 , EntityID Ent2 )
{
	f32 z1 , z2 , Dist;
	z1 = ENT_GetZ( Ent1 );
	z2 = ENT_GetZ( Ent2 );
	Dist = z1 - z2;
	if ( Dist < 0.0 ) Dist = -Dist;
	return (Dist);
}

//---------------------------------------------------------------

s32 GetNearestS32( f32 X )
{
	s32 ReturnedValue , sX;
	f32 fX;

	sX = X;
	fX = sX;

	if ( X < 0.0)
	{
		if ( fX-X < 0.5 )	return ( sX );
		else	return ( sX - 1 );
	}
	else if ( X > 0.0 )
	{
		if ( X-fX < 0.5 )	return ( sX );
		else	return ( sX + 1 );
	}
	else return (0);
}


s32 RandomS32( s32 Min , s32 Max )
{
	f32 Randf32 , fMax , fMin;
	s32 Rands32;

	Randf32 = UTL_GetRandom();
	fMax = Max;
	fMin = Min;

	Rands32 = GetNearestS32(Randf32 * (fMax - fMin) + fMin);
	return(Rands32);
}


f32 RandomF32( f32 Min , f32 Max )
{
	f32 Randf32;
	Randf32 = ( UTL_GetRandom() * (Max - Min) + Min );
	return(Randf32);
}


s32 PlayParticle( s32 Cible , f32 ModeAndNum , mcString ParticleName )
{
	if ( ( ModeAndNum == 0.0 ) || ( ModeAndNum == 1.0 ) )
		ENT_SetPropertyValueString( Cible , "PARTICLES" , "00_NAME" , "Custom" );
	else
		ENT_SetPropertyValueString( Cible , "PARTICLES" , "01_NAME" , "Custom" );
	ENT_SetPropertyValueString( Cible , "PARTICLES" , "00PARTICLES_FILE" , ParticleName );
	if ( ( ModeAndNum == 0.0 ) || ( ModeAndNum == 0.1 ) )
		ENT_SetPropertyValueS32( Cible , "PARTICLES" , "00PLAYMODE" , 0 );
	else
		ENT_SetPropertyValueS32( Cible , "PARTICLES" , "00PLAYMODE" , 1 );
	ENT_SetPropertyValueS32( Cible , "PARTICLES" , "00ACTIVE" , 1 );
}

void PlayParticleDelayed( s32 Cible , f32 ModeAndNum , mcString ParticleName )
{
	if ( ( ModeAndNum == 0.0 ) || ( ModeAndNum == 1.0 ) )
		ENT_SetPropertyValueString( Cible , "PARTICLES" , "00_NAME" , "Custom" );
	else
		ENT_SetPropertyValueString( Cible , "PARTICLES" , "01_NAME" , "Custom" );
	ENT_SetPropertyValueString( Cible , "PARTICLES" , "00PARTICLES_FILE" , ParticleName );
	if ( ( ModeAndNum == 0.0 ) || ( ModeAndNum == 0.1 ) )
		ENT_SetPropertyValueS32( Cible , "PARTICLES" , "00PLAYMODE" , 0 );
	else
		ENT_SetPropertyValueS32( Cible , "PARTICLES" , "00PLAYMODE" , 1 );
	ENT_SetPropertyValueS32( Cible , "PARTICLES" , "00ACTIVE" , 1 );
}


s32 PlaySmallExplosion( s32 Cible , f32 pipo , mcString ParticleName )
{
	ENT_SetPropertyValueS32( Cible , "EXPLOSION" , "CANEXPLODE" , 1 );
	ENT_SetPropertyValueF32( Cible , "EXPLOSION" , "HP_EXPLODE_POWER" , 30.0 );
	ENT_SetPropertyValueF32( Cible , "EXPLOSION" , "HP_EXPLODE_RADIUS" , 150.0 );
	ENT_SetPropertyValueF32( Cible , "EXPLOSION" , "LP_EXPLODE_POWER" , 10.0 );
	ENT_SetPropertyValueF32( Cible , "EXPLOSION" , "LP_EXPLODE_RADIUS" , 200.0 );
	ENT_SetPropertyValueF32( Cible , "EXPLOSION" , "STAMINA_EXPLODE_POWER" , 20.0 );
	ENT_SetPropertyValueF32( Cible , "EXPLOSION" , "STAMINA_EXPLODE_RADIUS" , 250.0 );

	ENT_SetPropertyValueString( Cible , "PARTICLES" , "00_NAME" , "Explode" );
	ENT_SetPropertyValueString( Cible , "PARTICLES" , "00PARTICLES_FILE" , ParticleName );
	ENT_SetPropertyValueS32( Cible , "PARTICLES" , "00PLAYMODE" , 1 );
	ENT_SetPropertyValueS32( Cible , "PARTICLES" , "00ACTIVE" , 1 );
	
	ENT_SetDamage( Cible , 0.0 );
}

