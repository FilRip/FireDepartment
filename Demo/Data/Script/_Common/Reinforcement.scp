	ENT_GroupAddEntity( AllUnit , Unit );

	SCR_SetVarS32("Unit" + UnitNumber , Unit );
	Orient = ENT_GetOrientationToEntity( LocStart , LocEnd );
	ENT_SetOrientation( Unit , Orient );
	SCR_SetVarS32("Vitesse" + UnitNumber , 0 );

	ENT_SetVisibility( Unit , 0 );

	UnitFlottant = UnitNumber;
	Delay = 10.0 + UnitFlottant;
	SCR_RunDelayedArgs("MoveArrivee" , Delay , UnitNumber , Combinaison , UnitName );

	if ( Combinaison == 1.0 )
