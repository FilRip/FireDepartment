}

//-------------------------------------------------------------------------------------------------

void MoveArrivee( s32 UnitNumber , f32 Combinaison , mcString UnitName )
{
	f32 x , y , CheminX , CheminY , VitesseArriveeFlottante;
	s32 Vitesse , VitesseArrivee;
	EntityID Unit;

	Unit = SCR_GetVarS32("Unit" + UnitNumber );
	ENT_SetVisibility( Unit , 1 );
	CheminX = SCR_GetVarF32("CheminX" + UnitNumber );
	CheminY = SCR_GetVarF32("CheminY" + UnitNumber );
	Vitesse = SCR_GetVarS32("Vitesse" + UnitNumber );
	VitesseArrivee = SCR_GetVarS32("VitesseArrivee");
	VitesseArriveeFlottante = VitesseArrivee;

	ENT_GetPosition( Unit , x , y );
	ENT_SetPosition( Unit , x + CheminX/VitesseArriveeFlottante , y + CheminY/VitesseArriveeFlottante );
	Vitesse += 1;
	SCR_SetVarS32("Vitesse" + UnitNumber , Vitesse );

	if ( Vitesse < VitesseArrivee )
		SCR_RunDelayedArgs("MoveArrivee" , 0.1 , UnitNumber , Combinaison , UnitName );
}

//-------------------------------------------------------------------------------------------------


void OutArrivee( EntityID Unit )
{
	ENT_SetVisibility( Unit , 1 );
}
