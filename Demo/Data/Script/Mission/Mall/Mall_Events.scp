//-
void OnCivilianSaved (EntityID civil)
{
	s32 civNum;
	
	civNum = getCivilNum(civil);
	
	if ( civNum==-1 )
	{
		// civil inconnu (non sauvable)
		return;
	}
	
	if ( civNum>=5 && civNum<=8 )
	{
		if ( SCR_GetVarS32("obj_civCine_end")!=1 )
		{
			updateIterativeObjective("civCine");
		}
	}
/*	else if ( civNum>=15 && civNum<=18 )
	{
		SCR_SetVarF32( "obj_saveCop_nbSaved" , SCR_GetVarF32( "obj_saveCop_nbSaved" )+1.0 );
		if ( SCR_GetVarF32( "obj_saveCop_nbSaved" ) == SCR_GetVarF32( "obj_saveCop_maxSaved" ) )
		{
			LEV_ValidateObjective( SCR_GetVarS32( "objIndex_saveCop" ) ,1);
			SCR_SetVarS32("obj_saveCop_end",1);
		}

		if ( SCR_GetVarS32("obj_saveCop_end")!=1 )
		{
			updateIterativeObjective("saveCop");
		}

	}
*/
	else if ( civNum>=12 && civNum<=14 )
	{
		if ( SCR_GetVarS32("obj_saveGan_end")!=1 )
		{
			updateIterativeObjective("saveGan");
		}
	}
}


//-
s32 updateIterativeObjective (mcString oName)
{
	f32 nbSaved;

	nbSaved = SCR_GetVarF32( "obj_"+oName+"_nbSaved" );
	nbSaved += 1.0;

	LEV_UpdateObjective( SCR_GetVarS32( "objIndex_"+oName ) , nbSaved );

	if ( nbSaved== SCR_GetVarF32( "obj_"+oName+"_maxSaved" ) )
	{
		LEV_ValidateObjective( SCR_GetVarS32( "objIndex_"+oName ) ,1);
		SCR_SetVarS32("obj_"+oName+"_end",1);
	}
	
	SCR_SetVarF32( "obj_"+oName+"_nbSaved" ,nbSaved);
}


