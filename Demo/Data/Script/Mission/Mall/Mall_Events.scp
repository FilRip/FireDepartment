// TODO : move to common ...

//- retourne le numéro du civil à partir de son EI
// retourne -1 si le civil n'est pas répertorié
s32 getCivilNum (EntityID civEI)
{
	mcString varName;
	varName = "civil_ent"+civEI+"_num";
	
	if ( SCR_VarExists(varName)==false() )
	{
		return (-1);
	}
	else
	{
		return ( SCR_GetVarS32(varName) );
	}
}


//- retourne l'EI d'un civil à partir de son numéro
EntityID getCivilEI (s32 civNum)
{
	return ( SCR_GetVarS32( "civil"+civNum ) );
}


//- active un tp
// Paramètres
// tpNum			numéro du tp (les noms de tps sont de la forme ent_tp[num] )
// activity			0 pour désactiver, 1 pour activer
s32 setTPActivity (s32 tpNum, s32 activity)
{
	ENT_SetVisibility( getEI("ent_tp"+tpNum) ,activity);
	
	return (0);
}



void BorneDestruction( EntityID Borne )
{
	SND_StopStaticSound( SCR_GetVarS32( ENT_GetName( Borne ) + "_sound" ) );
}


