void animBridge5b ()
{
	ANM_Play( getEI("civil_cop1") ,"SingleChar\sc_wait_civil_man1","loop",1);
}


//- 5 déplacement des gangsters
void animBridge5 ()
{
	entMoveToWP( getEI("gp_civ_ganBridge") , getEI("wp_gan2") );
	SCR_RunDelayed("animBridge6",40.0);
	SCR_RunDelayed("animBridge_clearGan",35.0);
}


//- debug : disparition des gangsters
// évite que les gangsters soient présents en 2 endroits différents si
// le joueur les empêche de prendre le téléport en bloquant le passage
