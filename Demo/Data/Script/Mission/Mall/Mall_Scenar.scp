// Scripts Mall_Scenar
// 18/05/04 : Création à partir de street
// 27/07/04 Olivier : modifs


/* init ******************************************************************************************/
//-
void Mall_StartScenar()
{
	// passer ScenarTrans à 0 quand y'aura des checks
	SCR_SetVarS32("ScenarTrans",0);
	SCR_SetVarS32("CurrentScenar",1);

	// permet de faire souffler le joueur
	// par défaut 3 sec avant d'enchaîner les actes
	SCR_SetVarF32("ScenarTempo",3.0);
	// pour attendre un moment avant les checks de passage aux actes suivants
	SCR_SetVarF32("TimerScenar", UTL_GetGameTime() + 10.0 );
}


/* main ******************************************************************************************/
//-
void Mall_CheckScenar()
{
	if ( UTL_GetGameTime() > 1.0 )
	{
		s32 ScenarTrans;
		s32 CurrentScenar;

		ScenarTrans = SCR_GetVarS32("ScenarTrans");
		CurrentScenar = SCR_GetVarS32("CurrentScenar");

		// si on est pas en train de faire une transition
		if (ScenarTrans != -1)
		{
			// si on a une transition à faire
			if (ScenarTrans != 0)
			{
				// on lance la transition
				SCR_SetVarS32("ScenarTrans" , -1 );
				SCR_RunDelayed("TransitionS" + ScenarTrans , SCR_GetVarF32("ScenarTempo") );
			}
			else
			{
				// sinon on check le scenar
				SCR_RunDelayed("CheckScenario" + CurrentScenar , 0.0 );
			}
		}
	}
}


/* partie 1 **************************************************************************************/
//-
void CheckScenario1()
{
	s32 fps , t;
	
	t = SCR_GetVarS32("script_t");
	fps = SCR_GetVarS32("script_fps");
	
	// anims de tirs sur le pont
	if ( mod(t, SCR_GetVarS32("civ_anim_nextStep")*fps )==0 )
	{
		animTirs( getEI("gp_civ_copBridge") );
		animTirs( getEI("gp_civ_ganBridge") );
		SCR_SetVarS32("civ_anim_nextStep", RandomS32(1,3) );
	}
	
	if ( UTL_GetGameTime() > SCR_GetVarF32("TimerScenar") )
		if ( ( FIR_HPGetActiveIntensity( getEI("gp_hp_sc1") ) ==0.0 ) || ( SCR_GetVarS32("SkipSreetCrash") ==1 ) )
			SCR_SetVarS32("ScenarTrans",2);
}


//-
void TransitionS2()
{
	s32 obj;
	f32 x, y;
	
	LEV_RoofVisibility("mall_theater_roof",0);
	SCR_SetVarS32("CurrentScenar" , 2 );
	
	// activation des tps du cinéma
	//setTPActivity(1,1);
	//setTPActivity(2,1);

	// [edit] l'électricité se s'allume plus
	
	obj = LEV_AddObjectiveIterate("&Maul_Obj2",0.0, SCR_GetVarF32("obj_civCine_maxSaved") ,1,0);
	SCR_SetVarS32("objIndex_civCine",obj);
	
	ENT_GetPosition( getEI("wp_obj_civCine") ,x,y);
	LEV_SetObjectivePos(obj,x,y);
	
	SCR_SetVarS32("ScenarTrans" , 0 );
	SCR_SetVarF32("TimerScenar" , UTL_GetGameTime() + 30.0 );
}

/* partie 2 **************************************************************************************/
//-
void CheckScenario2()
{
	s32 fps , t;
	f32 randomF;
	
	randomF = UTL_GetRandom();
	
	t = SCR_GetVarS32("script_t");
	fps = SCR_GetVarS32("script_fps");
	
	// anims de tirs sur le pont
	if ( mod(t, SCR_GetVarS32("civ_anim_nextStep")*fps )==2 )
	{
		animTirs( getEI("gp_civ_copBridge") );
		animTirs( getEI("gp_civ_ganBridge") );
		SCR_SetVarS32("civ_anim_nextStep", RandomS32(1,3) );
	}

	if ( mod(t,2*fps)==0 )
	{
		smokeDistribution(1);
		
		if ( SCR_GetVarS32("ElectricityOn") ==1 )
		{
			if ( randomF<0.15 ) elecGresil(1);
			else if ( randomF>0.75 ) elecExplo(1);
		}
	}
	
	
	if ( UTL_GetGameTime() > SCR_GetVarF32("TimerScenar") )
	{
		if ( SCR_GetVarF32("timerNextScenar")!=0.0 )
		{
			if ( UTL_GetGameTime() > SCR_GetVarF32("timerNextScenar") )
				SCR_SetVarS32("ScenarTrans",3);
			else if ( SCR_GetVarS32("obj_civCine_end")!=0 && FIR_HPGetActiveIntensity( getEI("gp_hp_sc2") ) <=300.0 )
				SCR_SetVarS32("ScenarTrans",3);
		}
/*		else if ( SCR_GetVarS32("obj_civCine_end")!=0 || FIR_HPGetActiveIntensity( getEI("gp_hp_sc2") ) <=300.0 )
		{
			// dès qu'un des objectifs remplis, timer lancé pour forcer le passage au scénar suivant
			SCR_SetVarF32("timerNextScenar", UTL_GetGameTime()+RandomF32(20.0,50.0) );
		}
*/		else if ( FIR_HPGetActiveIntensity( getEI("gp_hp_sc2") ) <=2000.0 )
		{
			// dès qu'un des objectifs remplis, timer lancé pour forcer le passage au scénar suivant
			SCR_SetVarF32("timerNextScenar", UTL_GetGameTime()+RandomF32(20.0,50.0) );
		}
		else if ( UTL_GetGameTime() > SCR_GetVarF32("TimerScenar") + 300.0 )
		{
			// timer, au bout de 6 minutes on passe à l'hélico de toute façon
			SCR_SetVarF32("timerNextScenar", UTL_GetGameTime()+RandomF32(20.0,40.0) );
		}
	}
}


//-
void TransitionS3()
{
	f32 x, y;
	
	LEV_RoofVisibility("mall_shops_roof",0);
	
	PNL_StartCutscene("data/video/mall_bridge.bik");
	
	ENT_GetPosition( getEI("ent_grenade_bridge") ,x,y);
	PNL_AddMessage("VOCAL_MALL_Maul_Warn4","&Maul_Warn4",x,y);
	
	SCR_RunDelayed("animBridge1",0.0);
	
	SCR_SetVarF32("TimerScenar" , UTL_GetGameTime() + 90.0 );
	SCR_SetVarF32("timerNextScenar",0.0);
}


/* partie 3 **************************************************************************************/
//-
void CheckScenario3()
{
	s32 fps , t;
	f32 randomF;
	
	randomF = UTL_GetRandom();
	
	t = SCR_GetVarS32("script_t");
	fps = SCR_GetVarS32("script_fps");
	
	if ( mod(t,2*fps)==0 )
	{
		smokeDistribution(2);
		
		if ( SCR_GetVarS32("ElectricityOn") ==1 )
		{
			if ( randomF<0.15 ) elecGresil(2);
			else if ( randomF>0.75 ) elecExplo(2);
		}
	}


	if ( UTL_GetGameTime() > SCR_GetVarF32("TimerScenar") )
	{
		if ( SCR_GetVarF32("timerNextScenar")!=0.0 )
		{
			if ( UTL_GetGameTime() > SCR_GetVarF32("timerNextScenar") )
				SCR_SetVarS32("ScenarTrans",4);
			else if ( SCR_GetVarS32("obj_saveCop_end")!=0 && FIR_HPGetActiveIntensity( getEI("gp_hp_sc3") ) <=300.0 )
				SCR_SetVarS32("ScenarTrans",4);
		}
		else if ( /*SCR_GetVarS32("obj_saveCop_end")!=0 ||*/ FIR_HPGetActiveIntensity( getEI("gp_hp_sc3") ) <=1500.0 )
		{
			// dès qu'un des objectifs remplis, timer lancé pour forcer le passage au scénar suivant
			SCR_SetVarF32("timerNextScenar", UTL_GetGameTime()+RandomF32(20.0,50.0) );
		}
		else if ( UTL_GetGameTime() > SCR_GetVarF32("TimerScenar") + 360.0 )
		{
			// timer, au bout de 6 minutes on passe à l'hélico de toute façon
			SCR_SetVarF32("timerNextScenar", UTL_GetGameTime()+RandomF32(20.0,40.0) );
		}
	}
}


void TransitionS4()
{
	PNL_StartCutscene("data/video/mall_helico.bik");
	PNL_AddMessage("VOCAL_MALL_Maul_Warn2","&Maul_Warn2",0.0,0.0);
	PNL_AddMessage("VOCAL_MALL_Maul_Warn3","&Maul_Warn3",0.0,0.0);	
	SCR_RunDelayed("CrashHelico" , 0.0 );
	
	SCR_RunDelayed("Renfort_2",45.0);
}


/* partie 4 **************************************************************************************/
//-
void CheckScenario4()
{
	s32 fps , t;
	
	t = SCR_GetVarS32("script_t");
	fps = SCR_GetVarS32("script_fps");
	
	if ( mod(t,2*fps)==5 )
	{
		smokeDistribution(3);
	}

	if ( UTL_GetGameTime() > SCR_GetVarF32("TimerScenar") )
	{
		if ( FIR_HPGetActiveIntensity( getEI("gp_hp_all") ) ==0.0 )
		{	SCR_SetVarS32("ScenarTrans",999);
			LEV_ValidateObjective( SCR_GetVarS32("objIndex_extinguishFire") ,1);
			// Si l'objectif des oeuvres à été lancé
			if ( SCR_GetVarS32("objIndex_oa")!=-1 )
			{
				LEV_ValidateObjective( SCR_GetVarS32("objIndex_oa") ,1);
				SCR_SetVarS32("obj_oa_end",-1);
			}
		}
	}
}


