{
	ENT_SetDamage( getEI("ent_windowRoof") ,0.0);
	
	SCR_RunDelayed("animBridge7",1.0);
}


//- 7 déplacement gangsters sur le toit
void animBridge7 ()
{
	s32 i;
	
	for (i=3; i<=5; i+=1)
	{	
		entMoveToWP( getCivilEI(i+9) , getEI( "wp_gan"+i ) );
	}
	
	SCR_RunDelayed("animBridge8",13.0);
