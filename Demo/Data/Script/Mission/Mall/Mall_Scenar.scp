//- 8 anim d'attente sur gangsters
void animBridge8 ()
{
	// direction des gangsters vers l'hélico
	ENT_SetFullOrientation( getCivilEI(12) ,0.0,0.0,1.40);
	ENT_SetFullOrientation( getCivilEI(13) ,0.0,0.0,1.22);
	ENT_SetFullOrientation( getCivilEI(14) ,0.0,0.0,0.87);
}


//- déplacement des policiers pendant l'anim
void ExploBridgeAnimCop (s32 runAnim)
{
	s32 i;
	f32 x, y;
	EntityID cop;
	
	if ( SCR_GetVarS32("stopSTFC")==0 )
	{
		for (i=2; i<=4; i+=1)
		{
			cop = getEI( "civil_cop"+i );

			if ( runAnim==1 )
			{
				ANM_Stop(cop);
				ANM_Play(cop,"SingleChar\sc_run_generic_fireman","loop",1);
				SCR_SetVarS32("animCopNoFire",1);
			}

			ENT_GetPosition(cop,x,y);
			x += SCR_GetVarF32( "vect_p"+i+"_x" );
			y += SCR_GetVarF32( "vect_p"+i+"_y" );
			ENT_SetForcedPosition(cop,x,y);
		}

		if ( x>13950.0 )
		{
			SCR_RunDelayedEntity("ExploBridgeAnimCop",0.2,0);
		}
		else
		{
			for (i=2; i<=4; i+=1)
			{
				cop = getEI( "civil_cop"+i );

				ANM_Stop(cop);
				ANM_Play(cop,"SingleChar\sc_shoot_gun","loop",1);
			}
		}
	}
}


/* animations crash hélico ***********************************************************************/
//- 1 arrivée hélico
void CrashHelico ()
{
	EntityID helico;
	
	helico = getEI("ent_helico");
	
	ENT_SetVisibility(helico,1);
	ENT_SetDamage(helico,50.0);
	
	SCR_RunDelayedEntity("tirsGan",17.0,12);
	SCR_RunDelayedEntity("tirsGan",17.2,13);
	SCR_RunDelayedEntity("tirsGan",17.4,14);
	
	SCR_RunDelayed("Boom1",26.0);
}


//- 2 anims tir sur hélico
void tirsGan (s32 civNum)
{
	EntityID ei;
	ei = getCivilEI(civNum);
		
	ANM_Stop(ei);
	ANM_Play(ei,"SingleChar\sc_shoot_gun","loop",1);
}


//- 3 explosion1 hélico
void Boom1 ()
{
	ENT_SetDamage( getEI("ent_grenade_helico1") ,0.0);
	ENT_SetUnitState( getCivilEI(12) , 3 );
	//ENT_AddStamina( getCivilEI(12) , -100.0);
// Rajout Tef
	ENT_SetUnitState( getCivilEI(14) , 3 );
	//ENT_SetStamina( getCivilEI(14) ,0.0);
	ENT_SetUnitState( getCivilEI(19) , 3 );
	
	SCR_RunDelayed("moveGan",1.0);
	SCR_RunDelayed("Boom2",4.0);
}


//- 4 fuite des gangsters
void moveGan ()
{
	s32 i, iWP;
	EntityID ei;

	iWP = 6;
	for (i=12; i<=14; i+=1)
	{
		ei = getCivilEI(i);
		
		//ENT_SetUnitState(ei,1);
		
		if ( ENT_GetStamina(ei)!=0.0 )
		{
			entMoveToWP(ei, getEI( "wp_gan"+iWP ) );
			iWP += 1;
		}
	}
}


//- 5 crash hélico au sol
void Boom2 ()
{
	s32 obj, i;
	f32 x, y;
	
	ENT_SetDamage( getEI("ent_grenade_helico2") ,0.0);
	FIR_HPAddIntensity( SCR_GetVarS32("HPHeli") , 50.0 );
		
	// fin de la transition -> passage au scénar 4
		
	obj = LEV_AddObjectiveIterate("&Maul_Obj4",0.0, SCR_GetVarF32("obj_saveGan_maxSaved") ,1,0);
	SCR_SetVarS32("objIndex_saveGan",obj);
	
	ENT_GetPosition( getEI("wp_obj_saveGan") ,x,y);
	LEV_SetObjectivePos(obj,x,y);
	
	obj = LEV_AddObjectiveBoolean("&Fireworks_Obj_4",0);
	SCR_SetVarS32("objIndex_extinguishFire",obj);
	
	// activation du tp du batiment
	setTPActivity(7,1);
	
	// les gangsters deviennent sauvables
//	for (i=12; i<=14; i+=1)
//	{
//		ENT_SetCapacityTarget( getCivilEI(i) ,"CouldBeRescue",1);
//	}
	ENT_SetUnitState( getCivilEI(13) , 1 );
	
	SCR_SetVarS32("ScenarTrans",0);
	SCR_SetVarS32("CurrentScenar",4);
	SCR_SetVarF32("TimerScenar", UTL_GetGameTime() +30.0 );
	
	SCR_RunDelayed("Boom3",4.0);
}

void Boom3()
{
	FIR_HPEnable( SCR_GetVarS32("hpafterboom") , 1 );
}

/* animations de policiers ***********************************************************************/

//- joue des anims aléatoires sur les civils du groupe
s32 animTirs (EntityID civGroup)
{
	s32 l, i;
	EntityID civ;
	
	if ( SCR_GetVarS32("animCopNoFire")==1 )
		return;
	
	l = ENT_GroupGetNbEntities(civGroup);
	i = getEI( "gp_"+civGroup+"_currI" );
	
	if ( i>=l )
		i = 0;

	civ = ENT_GroupGetEntityAt(civGroup,i);
	ANM_Stop(civ);
	ANM_Play(civ, getRandomAnim() ,"loop",1);
	
	i += 1;
	
	SCR_SetVarS32( "gp_"+civGroup+"_currI" ,i);
}


//- retourne une anim aléatoire
mcString getRandomAnim ()
{
	mcString anim;
	s32 n;
	
	n = RandomS32(1,6);
	
	if ( n==1 )
	{
		anim = "SingleChar\sc_wait_civil_man1";
	}
	else if ( n==2 )
	{
		anim = "SingleChar\sc_wait_civil_man2";
	}
	else
	{
		anim = "SingleChar\sc_shoot_gun";
	}
	
	return (anim);
}


/* [debut] explosions et gresillements électriques ***********************************************/

//- explosion aléatoire
s32 elecExplo (s32 elecNum)
{
	s32 rI;
	
	rI = getRandomLightNum(elecNum);
	
	if ( SCR_GetVarS32( "light_block"+rI+"_status" )==1 )
	{
		FIR_HPAddIntensity( getEI( "light_block"+rI+"_hp" ) ,100.0);
		SCR_SetVarS32( "light_block"+rI+"_status" ,-1);
	}
	
	return (0);
}


//- déclenche un grésillement aléatoire
s32 elecGresil (s32 elecNum)
{
	s32 rI;
	EntityID hp, light, item;
	
	rI = getRandomLightNum(elecNum);
	
	if ( SCR_GetVarS32( "light_block"+rI+"_status" )==0 )
	{
		hp = getEI( "light_block"+rI+"_hp" );
		item = getEI( "light_block"+rI+"_i" );
		light = getEI( "light_block"+rI+"_l" );
		
		SCR_SetVarS32( "light_block"+rI+"_status" ,1);
		
		// effet électrique sur item
		ENT_SetPropertyValueS32(item,"PARTICLES","00ACTIVE",1);
		
		// le hp électrique s'active
		FIR_HPEnable(hp,1);
		
		/* MAJ les clignotements de lumière sont supprimés
		
			// la lumière se coupe
			ENT_SetPropertyValueS32(light,"LIGHT","Light00_Active",0);
		
		*/
		
		SCR_RunDelayedArgs("GresilUpdate", UTL_GetRandom() ,rI,0.0,"");
	}
	
	return (0);
}


//- clignotement de la pièce
// MAJ s'occupe uniquement de désactiver le hotpoint électrique
void GresilUpdate (EntityID rI, f32 cpt, mcString useless)
{
	s32 n;
	f32 coef;
	EntityID light;
	
	light = getEI( "light_block"+rI+"_l" );
	
	n = cpt;
	
	// la pièce arrete de grésiller au bout de 41 ou si on coupe l'électricité
	if ( n==41 || SCR_GetVarS32("ElectricityOn")==0 )
	{
		EntityID hp, item;
		s32 status;
		
		hp = getEI( "light_block"+rI+"_hp" );
		item = getEI( "light_block"+rI+"_i" );
		status = SCR_GetVarS32( "light_block"+rI+"_status" );
		
		if ( status==1 )
		{
			SCR_SetVarS32( "light_block"+rI+"_status" ,0);
		}
		
		// effet électrique sur item disparaît
		ENT_SetPropertyValueS32(item,"PARTICLES","00ACTIVE",0);
		
		// le hp électrique se désactive
		FIR_HPEnable(hp,0);
		
		/* MAJ les clignotements de lumière sont supprimés
		
			// la lumière se coupe
			ENT_SetPropertyValueS32(light,"LIGHT","Light00_Active",0);
		
		*/
		
		return;
	}
	
	/* MAJ les clignotements de lumière sont supprimés

		if ( mod(n,2)==0 )
		{
			ENT_SetPropertyValueS32(light,"LIGHT","Light00_Active",1);
			coef = 2.0;
		}
		else
		{
			ENT_SetPropertyValueS32(light,"LIGHT","Light00_Active",0);
			coef = 0.8;
		}

	*/
	coef = 2.0;
	SCR_RunDelayedArgs("GresilUpdate", UTL_GetRandom()*coef ,rI, cpt+1.0 ,useless);
}


//- retourne un numéro de zone électrique aléatoire
s32 getRandomLightNum (s32 elecNum)
{
	s32 rI;
	s32 borneInf, borneSup;
	
	if ( elecNum==1 )
	{
		borneInf = 0;
		borneSup = SCR_GetVarS32("nLightBlocks1")-1;
	}
	else
	{
		borneInf = SCR_GetVarS32("nLightBlocks1");
		borneSup = SCR_GetVarS32("nLightBlocks2")-1;
	}
	
	rI = RandomS32(borneInf,borneSup);
	
	return (rI);
}

/* [fin] explosions et gresillements électriques *************************************************/


/* transferts de fumée scriptés ******************************************************************/


//- propagation de fumée
// Paramètre :
// i	indice de progression du joueur (1 pour début du jeu, 2 pour scénario 3, 3 pour la fin)
s32 smokeDistribution (s32 i)
{
	s32 j;
	mcBool elecIsOn;	
	elecIsOn = SCR_GetVarS32("ElectricityOn")==1;
	
	for (j=1; j<=6; j+=1)
	{
		DSP_PartEnable( getEI("VentExt_"+j) ,"vent",0);
	}
	
	if ( i==1 )
	{
		// propagation en fonction de l'électricité
		if ( elecIsOn )
		{
			smokeScattering(1);
		}
		else
		{
			smokeGeneration(1,10);
		}
	}
	else if ( i==2 )
	{
		// dispertion sur le premier batiment
		smokeScattering(1);
		
		// propagation en fonction de l'électricité
		if ( elecIsOn )
		{
			smokeScattering(2);
		}
		else
		{
			smokeGeneration(11,18);
		}
	}
	else
	{
		// fin de mission, dispertion totale
		smokeScattering(1);
		smokeScattering(2);
	}
	
	return (0);
}


//- génération de fumée entre les sp_evac_in et sp_evac_out
// Paramètres :
// start	numéro du smokepoint du début
// end		numéro du smokepoint de fin
s32 smokeGeneration (s32 start, s32 end)
{
	EntityID spI, spO;
	f32 vI , vO;
	s32 i;

	for (i=start; i<=end; i+=1)
	{
		// modifier ici si la propagation est trop rapide
		spI = getEI("sp_evac_in" + i );
		spO = getEI("sp_evac_out" + i );

		vO = FIR_SPGetIntensity(spO);
		vI = FIR_SPGetIntensity(spI);

		FIR_SPAddIntensity(spI,-100.0);
		FIR_SPAddIntensity(spO,-100.0);
		
		if ( vO>vI )
		{

			FIR_SPAddIntensity(spI, vI*0.35 + vO*0.6 );
			FIR_SPAddIntensity(spO, vO*0.95 );
		}
		else
		{
			FIR_SPAddIntensity(spI, vI*0.95 );
			FIR_SPAddIntensity(spO, vI*0.6 + vO*0.35 );
		}
	}

	return (0);
}


//- dispersion de la fumée
// Paramètre :
// gNum		numéro du groupe de smokepoint
s32 smokeScattering (s32 spNum)
{
	EntityID spGroup;
	s32 n;
	
	spGroup = getEI( "gp_sp_part"+spNum );
	
	FIR_SPAddIntensity(spGroup,-6.0);
	
	n = (spNum-1)*3;
	
	if ( FIR_SPGetIntensity(spGroup) > 100.0 )
	{
		DSP_PartEnable( getEI("VentExt_"+ (n+1) ) ,"vent",1);
		DSP_PartEnable( getEI("VentExt_"+ (n+2) ) ,"vent",1);
		DSP_PartEnable( getEI("VentExt_"+ (n+3) ) ,"vent",1);
	}
	
	return (0);
}
