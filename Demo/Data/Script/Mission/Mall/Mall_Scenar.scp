/* anims explosion du pont ***********************************************************************/
//- 1 les policiers qui courent
void animBridge1 ()
{
	SCR_RunDelayedEntity("ExploBridgeAnimCop",0.2,1);

	SCR_RunDelayed("animBridge2",2.0);
}


//- 2 explosion
void animBridge2 ()
{
	s32 i, length;
	EntityID trig, group, unit;
	
	// bloque le déplacement des policiers puis les rend invisibles
	SCR_SetVarS32("stopSTFC",1);
	
	for (i=2; i<=4; i+=1)
	{	ENT_SetVisibility( getEI( "civil_cop"+i ) ,0);
	}
	
	// explo grenade
	ENT_SetDamage( getEI("ent_grenade_bridge") ,0.0);
	FIR_HPAddIntensity( SCR_GetVarS32("HPPont") , 50.0 );
	
	// destruction du pont et vitre dessous
	ENT_SetDamage( getEI("Bridge") ,0.0);
	ENT_SetDamage( getEI("ent_bridgePane") ,0.0);
	
	PlayParticle( getEI("Bridge") ,1.0,"Smoke_Outside1");
	
	SCR_RunDelayed("animBridge3",2.0);
	SCR_RunDelayed("animBridge4",2.0);
	
	// tue les unités sous le pont
	group = ENT_GroupCreate("__gp_bridge__");
	
	TRG_FillGroupWithContent( getEI("trig_bridge") ,group);
	length = ENT_GroupGetNbEntities(group);
	
	for (i=0; i<length; i+=1)
	{	
		unit = ENT_GroupGetEntityAt(group,i);
		if ( ENT_GetType(unit)==13 || ENT_GetType(unit)==14 )
		{	
			ENT_SetDamage(unit,0.0);
		}
	}
	ENT_Destroy(group);
}


//- 3 débris
void animBridge3 ()
{
	EntityID e;
	s32 i, obj;
	f32 x, y;

	for (i=1; i<=4; i+=1)
	{
		e = getEI( "BridgePiece"+i );
		ENT_SetVisibility(e,1);
		SCR_RunDelayedArgs("PlayParticleDelayed",1.0,e,1.0,"Smoke_Outside1");
	}

//	ENT_SetVisibility(SCR_GetVarS32("gp_axe_debris") , 1 );

	for (i=1; i<=4; i+=1)
	{
		ENT_SetVisibility(SCR_GetVarS32("axe_debris_" + i ) , 1 );
	}

	ENT_SetVisibility( getEI("gp_ent_trashBridge") ,1);

	// ajout obj : trouver les policiers
// Délivrer les 3 policiers avant la fin du timer
	obj = LEV_AddObjectiveProgress("&Maul_Obj3",0.0, SCR_GetVarF32("TimerDiff") ,1,0);
	SCR_SetVarF32("TimerEboulis" , 1.0 );

//	obj = LEV_AddObjectiveIterate("&Maul_Obj3",0.0, SCR_GetVarF32("obj_saveCop_maxSaved") ,1,0);
	SCR_SetVarS32("objIndex_saveCop",obj);
	
	ENT_GetPosition( getEI("wp_obj_saveCop") ,x,y);
	LEV_SetObjectivePos(obj,x,y);
	
	// renfort
	SCR_RunDelayed("Renfort_1",35.0);
	
	// activation des TPs du batiment
	//setTPActivity(3,1);
	//setTPActivity(4,1);
	setTPActivity(5,1);
	SCR_RunDelayed("CorrectionTeleport",25.0);
	//setTPActivity(6,1);

	
	// passage au scénario suivant
	SCR_SetVarS32("CurrentScenar",3);
	SCR_SetVarS32("ScenarTrans",0);
}

void CorrectionTeleport()
{
	setTPActivity(5,0);	
}

//- 4 déplacement des gangsters et du policier bloquant l'entrée
void animBridge4 ()
{
	entMoveToWP( getEI("gp_civ_ganBridge") , getEI("wp_gan1") );
	
	entMoveToWP( getEI("civil_cop1") , getEI("wp_cop1_move1"));
	
	// ouverture de la porte invisible pour accès au batiment scénario 3
	ENT_SwitchState( getEI("ent_invisiDoor") );
	
	SCR_RunDelayed("animBridge5",7.0);
	SCR_RunDelayed("animBridge5b",6.0);
}


