/* cinématiques **********************************************************************************/
//- début intro
void CameraIntro ()
{
	CAM_ModeCinematic();
	CAM_Cinematic(1);

	SCR_SetVarF32("InertiaBackup", CAM_GetInertia() );
	CAM_SetInertia(1.0);
	
	SCR_RunDelayed("CameraCarambolage",3.0);
}

void CameraCarambolage ()
{
	CAM_TeleportToWayPoint( getEI("cam_carambolage") );

	SCR_RunDelayed("CameraDispatch1",3.2);
}

void CameraDispatch1 ()
{
	CAM_TeleportToWayPoint( getEI("cam_dispatch1") );

	SCR_RunDelayed("CameraDispatch2",1.5);
}

void CameraDispatch2 ()
{
	CAM_TeleportToWayPoint( getEI("cam_dispatch2") );

	SCR_RunDelayed("CameraDispatch3",1.5);
}

void CameraDispatch3 ()
{
	CAM_TeleportToWayPoint( getEI("cam_dispatch3") );

	SCR_RunDelayed("CameraDispatch4",2.0);
}

void CameraDispatch4 ()
{
	//CAM_SetToWayPoint( getEI("cam_dispatch4") );

	SCR_RunDelayed("CameraOutro",2.0);
}


//- fin intro
void CameraOutro ()
{
	s32 obj;
	f32 x, y;
	
	CAM_SetInertia( SCR_GetVarF32("InertiaBackup") );
	
	CAM_TeleportToWayPoint( getEI("cam_outro") );
	
	CAM_ModePlay();
	CAM_Cinematic(0);
	
	obj = LEV_AddObjectiveBoolean("&Maul_Obj1",0);
	SCR_SetVarS32("objIndex_street",obj);
	
	ENT_GetPosition( getEI("wp_obj_street") ,x,y);
	LEV_SetObjectivePos(obj,x,y);
}


