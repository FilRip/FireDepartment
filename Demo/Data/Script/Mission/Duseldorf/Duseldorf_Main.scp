///////////////////start catFly
void Cat_Fly()
{
	
	if(SCR_GetVarS32("CatRadio_Start")==1)
	{
		SCR_RunDelayed("Cat_Fly",16.0);
	}
	
	else
	{
	SCR_RunDelayed("flag_fly_start",0.0);
	CAM_Cinematic(1);
	CAM_ModeCinematic();
	CAM_SetInertia(1.0);

	SCR_SetVarS32("Plane_Vzletel",1);

	SCR_RunDelayed("catfly_tel_cam1",0.0);
	SCR_RunDelayed("Start_Propelers",2.0);
	SCR_RunDelayed("Start_Fly",4.0);
	SCR_RunDelayed("catfly_go_cam2",5.0);
	SCR_RunDelayed("Stop_Fly",17.0);
	SCR_RunDelayed("Hide_Plane",17.4);
	SCR_RunDelayed("catfly_tel_cam4",17.0);
	SCR_RunDelayed("cam_play",17.5);
	SCR_RunDelayed("Canadair_support",20.0);
	ENT_SetVisibility(5008619,0);
	SCR_RunDelayed("flag_fly_end",18.0);

	}
}

void flag_fly_start()
{
	SCR_SetVarS32("CatFly_Start",1);
}

void flag_fly_end()
{
	SCR_SetVarS32("CatFly_Start",0);
}


void cam_play()
{
	CAM_Cinematic(0);
	CAM_SetInertia(0.0);
	CAM_ModePlay();
	PNL_ClearSubtitle();
} 

void Hide_Plane()
{
	ENT_SetVisibility(5000849,0);
}
void Start_Propelers()
{
	ENT_SwitchState(5000849);
}

void Start_Fly()
{
	SCR_SetVarS32("Air_Run_Var",1);
}

void Stop_Fly()
{
	SCR_SetVarS32("Air_Run_Var",0);
}

void catfly_tel_cam1()
{
	CAM_TeleportToWayPoint(ENT_FindByName("catfly_cam1")); 
}

void catfly_go_cam2()
{
	CAM_CinematicSetToWaypoint(ENT_FindByName("catfly_cam2"), 7.0);
}

void catfly_tel_cam4()
{
	CAM_TeleportToWayPoint(ENT_FindByName("catfly_cam4")); 
}

void AirPlane_Go()
{
	f32  x, y;

	ENT_GetPosition(5000849, x , y ) ; 

	if(SCR_GetVarF32("end_x") >x)
   	 {
	
		f32 S;
		S = 130;
		ENT_SetPosition(5000849, x+S, y);
	}
}
	

///////////////////End CatFly

////////////////////start Cat_Radio

void Cat_Radio()
{

	if(SCR_GetVarS32("CatFly_Start")==1)
	{
		SCR_RunDelayed("Cat_Radio",25.0);
	}
	else
	{
	CAM_Cinematic(1);
	CAM_ModeCinematic();
	CAM_SetInertia(1.0);

	SCR_RunDelayed("flag_radio_start" ,0.0);
	
	ENT_SetCapacityTarget(5003470, "CouldBeUse" ,1);
	ENT_SetVisibility(5005328,1);

	SCR_RunDelayed("Samolet_Disactivate" , 0.0);	

	SCR_RunDelayed("catradio_tel_cam1",0.0);

	SCR_RunDelayed("catradio_mes1" , 1.0);

	SCR_RunDelayed("catradio_go_cam2",2.0);

	SCR_RunDelayed("catradio_tel_cam3" , 8.0);
	
	SCR_RunDelayed("catradio_mes2", 8.5);

	SCR_RunDelayed("cam_play",15.0);

	SCR_RunDelayed("flag_radio_end",16.0);

	SCR_RunDelayed("add_obbj6",16.0);
	if(SCR_GetVarS32("Lock_On")==0)
	{
		SCR_RunDelayed("Samolet_Activate",16.0);
	}
	}
}

void flag_radio_start()
{
	SCR_SetVarS32("CatRadio_Start",1);
}

void flag_radio_end()
{
	SCR_SetVarS32("CatRadio_Start",0);
}

void Samolet_Disactivate()
{
	ENT_SetCapacityTarget(5000849, "CouldBeUse" ,0);
}

void Samolet_Activate()
{
	ENT_SetCapacityTarget(5000849, "CouldBeUse" ,1);
}

