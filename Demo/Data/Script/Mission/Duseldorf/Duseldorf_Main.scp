void add_obbj1()//Spasti ludey v ofisnych zdaniyach
{
	s32 j;
	SCR_SetVarS32("Obj_1", LEV_AddObjectiveBoolean("&DUSS_Obj1", 1));
	j = LEV_SetObjectivePos(SCR_GetVarS32("Obj_1"), 4571.19, 12604.97);
	SCR_SetVarS32("Obj1_Activated",1);
	LEV_ActivateObjectivesPanel(1);
}

void add_obbj2()//Predotvratit vozgoranie terminala
{
	s32 j,i,k,n;
	SCR_SetVarS32("Obj_2", LEV_AddObjectiveBoolean("&DUSS_Obj2", 1));
	j = LEV_SetObjectivePos(SCR_GetVarS32("Obj_2"), 5511.61, 7281.88);
	SCR_SetVarS32("Obj2_Activated",1);
	LEV_ActivateObjectivesPanel(1);
}

void add_obbj3()//Potushit baki s toplivom
{
	s32 j;
	SCR_SetVarS32("Obj_3", LEV_AddObjectiveBoolean("&DUSS_Obj3",1));
	j = LEV_SetObjectivePos(SCR_GetVarS32("Obj_3"), 10154.73, 11464.66);
	LEV_ActivateObjectivesPanel(1);
	SCR_SetVarS32("Obj3_Activated",1);
}


void add_obbj4()//Spasti samolet canandir
{
	s32 j;
	SCR_SetVarS32("Obj_4", LEV_AddObjectiveBoolean("&DUSS_Obj4",1)); 
	//SCR_SetVarS32("Obj_4", LEV_AddObjectiveBoolean("&DUSS_Obj4", 1));
	j = LEV_SetObjectivePos(SCR_GetVarS32("Obj_4"), 18059.87, 15413.69);
	LEV_ActivateObjectivesPanel(1);
	SCR_SetVarS32("Obj4_Activated",1);

	ENT_SetVisibility(5008619,1);
}

void update_obbj4()
{
	LEV_UpdateObjective(SCR_GetVarS32("Obj_4") , SCR_GetVarF32("Time_Cur_Obj4"));
	f32 t;
	t=SCR_GetVarF32("Time_Cur_Obj4");
	t=t-0.5;
	SCR_SetVarF32("Time_Cur_Obj4" , t);
	if(SCR_GetVarF32("Time_Cur_Obj4") <2.0)
	{
		SCR_SetVarS32("Ob4_sys",0);
		SCR_RunDelayed("Val_obbj4",1.0);
		SCR_RunDelayed("Cat_Fly" ,2.0);

	}
} 

