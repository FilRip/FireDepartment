void add_obbj8()//Potushit workshop
{
	s32 j;
	SCR_SetVarS32("Obj_8", LEV_AddObjectiveProgress("&DUSS_Obj8", 0.0 ,SCR_GetVarF32("HP_WorkShop"), 0 ,0));
	j = LEV_SetObjectivePos(SCR_GetVarS32("Obj_8"), 8133.24, 3246.03);
	SCR_SetVarS32("Obj8_Activated",1);
	LEV_ActivateObjectivesPanel(1);
}

void Update_Obj8()
{
	f32 k,m;

	m=FIR_HPGetIntensity(SCR_GetVarS32("WorkShop_F")) * 0.03;

	k = SCR_GetVarF32("HP_WorkShop");
	
	k = k - m;
	
	SCR_SetVarF32("HP_WorkShop", k);

	LEV_UpdateObjective(SCR_GetVarS32("Obj_8") , SCR_GetVarF32("HP_WorkShop"));


	if(SCR_GetVarF32("HP_WorkShop") <= 2.0)
	{
		SCR_RunDelayed("End_Upd_Obj8",0.0);
		SCR_RunDelayed("Proval_obj8",1.0);
		
	}

	if(FIR_HPGetActiveIntensity(SCR_GetVarS32("Workshop_all_F")) ==0.0)
	{
		SCR_RunDelayed("End_Upd_Obj8",0.0);
		SCR_RunDelayed("Val_obbj8",1.0);
	}

}
