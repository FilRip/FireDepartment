void InitVar()
{
		
            s32 i, j;
	s32 NbCivil;
	s32 sRatio;
	sRatio = 75 - LEV_GetDifficultyLevel() * 25;
	SCR_SetVarS32("MaxDeadFiremen", (LEV_GetNumFiremen()*sRatio)/100);
 	SCR_SetVarS32("NumDestroyedPumpers", 0);
	InitCivil();
	PNL_RemoveAllFocus();
	EntityID Group; 

	//////////////////////////////// start initialize objectives
	SCR_SetVarS32("Obj_1", 0);//spasite civilov v adminzdanii
	SCR_SetVarS32("Obj_2", 0);//udergat ogon do priezda reinforsmenta s penoi
	SCR_SetVarS32("Obj_3" ,0);//potushit baki s toplivom
	SCR_SetVarS32("Obj_4" ,0);//Spasti samolet canadier
	SCR_SetVarS32("Obj_8" ,0);//naiti i ispolzovat vspomagatelnuu radiostaniyu
	SCR_SetVarS32("Obj_6" ,0);//Ispolzovat Radiostanziyu
	SCR_SetVarS32("Obj_7" ,0);//Potushit ogon v angarach
	//////////////////////////////// end  initialize objectives


	//////////start flagi vipolneniya objectivov
	SCR_SetVarS32("Obj1_Done" , 0);
	SCR_SetVarS32("Obj2_Done" , 0);
	SCR_SetVarS32("Obj3_Done" , 0);
	SCR_SetVarS32("Obj4_Done" , 0);
	SCR_SetVarS32("Obj8_Done" , 0);
	SCR_SetVarS32("Obj6_Done" , 0);
	SCR_SetVarS32("Obj7_Done" , 0);
	SCR_SetVarS32("Obj8_Done",0);
	//////////end flagi vipolneniya objectivov


	/////////start flagi activazii objey
	SCR_SetVarS32("Obj1_Activated",0);
	SCR_SetVarS32("Obj2_Activated",0);
	SCR_SetVarS32("Obj3_Activated",0);
	SCR_SetVarS32("Obj4_Activated",0);
	SCR_SetVarS32("Obj8_Activated",0);
	SCR_SetVarS32("Obj6_Activated",0);	
	SCR_SetVarS32("Obj7_Activated",0);
	/////////end flagi activazii objey

	//////// start sistemnie flagi
	
	SCR_SetVarS32("FrancID" , 0);
	SCR_SetVarS32("Franc_sys" , 0);
	SCR_SetVarS32("Ob1_sys" , 1);
	SCR_SetVarS32("Ob2_sys" , 1);
	SCR_SetVarS32("Ob3_sys" , 1);
	SCR_SetVarS32("Ob4_sys" , 1);
	SCR_SetVarS32("Ob8_sys" , 1);
	SCR_SetVarS32("Ob6_sys" , 1);
	SCR_SetVarS32("Ob7_sys" , 1);
	//////// end sistemnie flagi

	SCR_SetVarS32("Stor_Term_sys",1);


	SCR_SetVarS32("Plane_lock",0);

	///////start data variable
	SCR_SetVarS32("Num_Civils" , 5);
	SCR_SetVarS32("Cur_Num_Civils", 5);

	SCR_SetVarF32("end_x",29097.66);
	SCR_SetVarS32("Air_Run_Var",0);

	SCR_SetVarF32("Time_Obj4",200.0);
	SCR_SetVarF32("Time_Cur_Obj4" , 200.0);

	SCR_SetVarS32("Plane_Vzletel",0);
	SCR_SetVarS32("O2_vipol",0);
	SCR_SetVarS32("Lock_On",0);

	SCR_SetVarF32("HP_WorkShop", 260000.0);

	SCR_SetVarS32("St_up_O8",0);
	///////end data variable///

	

	//init global identifiers for fire groups
   	Group = ENT_FindByName("Terminal_Fire");
   	SCR_SetVarS32("Terminal_F", Group);

	Group = ENT_FindByName("store_to_terminal_fire");
   	SCR_SetVarS32("store_to_terminal_F", Group);

	Group = ENT_FindByName("under_plane_fire");
   	SCR_SetVarS32("under_plane_F", Group);

	Group = ENT_FindByName("barell_fire");
   	SCR_SetVarS32("Barell_F", Group);
//
	Group = ENT_FindByName("all_to_terminal_fire");
   	SCR_SetVarS32("all_to_terminal_F", Group);

	Group = ENT_FindByName("two_hangars_fire");
	SCR_SetVarS32("two_hangars_F" , Group);

	Group = ENT_FindByName("WorkShop_fire");
	SCR_SetVarS32("WorkShop_F" , Group);

	Group = ENT_FindByName("Workshop_all_fire");
	SCR_SetVarS32("Workshop_all_F" , Group);

	


	//////////////////////Bugs
	SCR_SetVarS32("CatFly_Start",0);
	SCR_SetVarS32("CatFly_Stop",1);

	SCR_SetVarS32("CatRadio_Start",0);





}

///end initvar


////start main
void Duseldorf_Main()
{
	if(UTL_GetGameTime()>1.0)
	{




		//////////////start identifikaziya franca
		if(SCR_GetVarS32("Franc_sys") ==1)
		{
			if(ENT_GetUnitState(SCR_GetVarS32("FrancID")) == 4)
			{
			
				SCR_SetVarS32("ScenarTrans", 666);
				SCR_SetVarString("DebriefText", "&FrancDieText");
		
			}
		}
		//////////////end identifikaziya franca

		////////////start proverca vipolneniya objectiva s civilami obj1
		if(SCR_GetVarS32("Ob1_sys" )==1)
		{
			if(SCR_GetVarS32("Cur_Num_Civils")==0)
			{
				SCR_RunDelayed("Val_obbj1" , 0.0);
				SCR_SetVarS32("Ob1_sys",0);
				ENT_SetDamage(5004218,0.0);
			}

		}


		////////////end  proverca vipolneniya objectiva s civilami
		

		if(SCR_GetVarS32("Air_Run_Var")==1)
		{
			AirPlane_Go();
		}

		//if(SCR_GetVarS32("Obj4_Activated")==1)
		//{
		//	if(SCR_GetVarS32("Ob4_sys")==1)
		//	{
		//		update_obbj4();
		//	}
		//}

		/////////////////////////////////start proverka zgoraniya samoleta

		if(FIR_HPGetActiveIntensity(SCR_GetVarS32("under_plane_F")) != 0.0)
		{
			if(SCR_GetVarS32("Plane_Vzletel")==0)
			{
				SCR_SetVarS32("Plane_Vzletel",1);
				ENT_SetVisibility(5008619,0);
				SCR_SetVarS32("Ob4_sys",0);
				Proval_obj4();
				SCR_SetVarS32("Plane_lock",1);

				//////////Sdelat samolet ne usabilnim
			}
		}
		
		/////////Start Proverca proigrasha po vozgoraniyu Terminala
		if(FIR_HPGetActiveIntensity(SCR_GetVarS32("Terminal_F")) >40.0)
		{
			if(SCR_GetVarS32("Ob2_sys")==1)
			{
				SCR_SetVarS32("ScenarTrans", 666);
				SCR_SetVarString("DebriefText", "&Duseldorf_Terminal_Defeat");
				SCR_SetVarS32("Ob2_sys",0);
			}
		} 
		/////////end Proverca proigrasha po vozgoraniyu Terminala

		if(FIR_HPGetActiveIntensity(SCR_GetVarS32("store_to_terminal_F"))!=0.0)
		{
			if(SCR_GetVarS32("Stor_Term_sys")==1)
			{
				SCR_SetVarS32("Stor_Term_sys",0);
				SCR_RunDelayed("Cat_2",5.0);
				SCR_RunDelayed("Second_Reinforsment",15.0);
				
			}
		}
		

		////////////////////start proverka obj2
		if(FIR_HPGetActiveIntensity(SCR_GetVarS32("all_to_terminal_F"))==0.0)
		{
			if(UTL_GetGameTime()>4.0)
			{
				if(SCR_GetVarS32("O2_vipol")==0)
				{
				
					SCR_SetVarS32("O2_vipol" , 1);
					Val_obbj2();
				}
			}

		}

		/////////Start Proverca vipolneniya Obj3 Potushit Bareli
		if(FIR_HPGetActiveIntensity(SCR_GetVarS32("Barell_F")) == 0.0)
		{
			if(SCR_GetVarS32("Ob3_sys")==1)
			{
				if(UTL_GetGameTime()>4.0)
			
				{
				SCR_RunDelayed("Val_obbj3",0.0);
				SCR_SetVarS32("Ob3_sys",0);
				}
			}
		}
		/////////end Proverca vipolneniya Obj3 Potushit Bareli
		

	///////////////////////////strat proverka pobedy
	if(SCR_GetVarS32("Obj1_Done")==1&&SCR_GetVarS32("Obj3_Done")==1&&SCR_GetVarS32("Obj6_Done")==1&&SCR_GetVarS32("Obj7_Done")==1)
	{
		Victory();
	}
	///////////////////////////end  proverka pobedy

	if(FIR_HPGetActiveIntensity(SCR_GetVarS32("two_hangars_F"))==0.0)
		{
			if(UTL_GetGameTime()>4.0)
			{
				if(SCR_GetVarS32("Ob7_sys")==0)
				{
				
					SCR_SetVarS32("Ob7_sys" , 1);
					Val_obbj7();
				}
			}

		}

	

	///////////////////////////dobavleniye 8 objectiva

	if(FIR_HPGetActiveIntensity(SCR_GetVarS32("WorkShop_F")) !=0.0)
	{
		if(SCR_GetVarS32("Ob8_sys")==1)
		{
			SCR_SetVarS32("Ob8_sys" , 0);
			SCR_RunDelayed("add_obbj8",0.0);
			SCR_RunDelayed("Start_Upd_Obj8",1.0);

		}

	}		

	if(SCR_GetVarS32("St_up_O8")==1)
	{
		Update_Obj8();

	}

	

	
	}

}
/////end Main

void Start_Upd_Obj8()
{
	SCR_SetVarS32("St_up_O8",1);
}

void End_Upd_Obj8()
{
	SCR_SetVarS32("St_up_O8",0);
}

void PodzegOfis_Stor()
{
	FIR_HPEnable(ENT_FindByName("Ofice1_fire"),1);
	FIR_HPEnable(ENT_FindByName("Ofice2_fire"),1);
	FIR_HPEnable(ENT_FindByName("Storage_fire"),1);
}

void InitCivil()
{
	s32 i ,  j , NbCivil, NumCivilActive;
	f32 x , y , z; 

	NbCivil = 5;
	SCR_SetVarS32("NbCivil"  , NbCivil);
	SCR_SetVarS32("MaxDeadCivil" , 3 - LEV_GetDifficultyLevel());

}

