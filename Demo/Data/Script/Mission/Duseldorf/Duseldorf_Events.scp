void Store_Fire_Activate(EntityID unitID, EntityID id_PIPO)
{
	ENT_SetVisibility(5000079,1);
	ENT_SetVisibility(5000073,1);
	ENT_Destroy(5003357);
	ENT_Destroy(5003355);
	LEV_RoofVisibility("Duss_Storeg_ROOF",0);
	FIR_HPEnable(ENT_FindByName("Storage_fire"),1);
	
}

