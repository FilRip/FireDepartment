void RadioRele(EntityID Civilian)
{
	if(SCR_GetVarS32("Ob6_sys")==1)
	{
	SCR_SetVarS32("ScenarTrans", 666);
	SCR_SetVarString("DebriefText", "&Duseldorf_RadioRele_Defeat");
	}

}

void Fly_Use(EntityID User , EntityID Armoire , mcString State)
{
		if(SCR_GetVarS32("Lock_On")==0)
		{

		if(SCR_GetVarS32("Plane_lock")==0)
		{
		SCR_SetVarS32("Ob4_sys",0);
		SCR_RunDelayed("Val_obbj4",1.0);
		SCR_RunDelayed("Cat_Fly" ,1.1);
		ENT_SetVisibility(5008619,0);
		ENT_SetCapacityTarget(5000849, "CouldBeUse" ,0);
		SCR_SetVarS32("Lock_On",1);
		}
	
		}
		//////////Sdelat samolet ne usabilnim
}
