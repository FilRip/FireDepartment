

void Civil_Death(EntityID Civilian)///////////// for function OnLifepoint0
{
	s32 c;
	c=SCR_GetVarS32("Cur_Num_Civils");
	c=c-1;
	SCR_SetVarS32("Cur_Num_Civils" , c);
	
}



void OnCivilianSaved(EntityID Civilian)
{
	s32 k;
	k=SCR_GetVarS32("Cur_Num_Civils");
	k=k-1;
	SCR_SetVarS32("Cur_Num_Civils" , k);

} 

////////////////////////////unique pesonalize script function
void OnEnterStartTRG(EntityID unitID, EntityID id_PIPO)
{
	if(ENT_GetUnitType(unitID) ==0)
	{
		//PNL_AddMessage("", "&OpenDoor", 0.0,0.0);
		SCR_SetVarS32("FrancID" , unitID);
		SCR_SetVarS32("Franc_sys" , 1);
	}
}
//////////////////////////////////////////end initialaize franc

/////////////////////////////////////////start objectivs trigers
void Found_Radio_ValObj5(EntityID unitID, EntityID id_PIPO)
{
	if(SCR_GetVarS32("Ob5_sys")==0)
	{
	SCR_RunDelayed("Val_obbj5",0.0);
	SCR_RunDelayed("add_obbj6",0.2);
	ENT_Destroy(5006352);
	}
}

/////////////////////////////////////////end objectivs trigers

////////////////////////////////////////start usable objects
void Radio_Use(EntityID User , EntityID Armoire , mcString State)
{	
	SCR_RunDelayed("Val_obbj6",0.0);
	SCR_SetVarS32("Ob6_sys" , 0);
	ENT_SetCapacityTarget(5003470, "CouldBeUse" ,0);
	ENT_SetVisibility(5005328,0);

}

////////////////////////////////////////END usable objects

////////////////////////////start atack nepravilnie ogni

// the type of the fire agent of the unit. (Fire agents : 0=Water, 1=Foam, 3=Powder, 4=Metal)
// the type of fire.FireTypes : (0=A, 1=B, 2=C, 3=D)
void AttackWrongFire( s32 Unit , s32 Fire , s32 FireAgent , s32 FireType )
{
	s32 i , optim;
	f32 x , y;
	ENT_GetPosition( Fire , x , y );

	if ( ( FireAgent == 0 ) && ( FireType == 1 ) )
	{
		
		PNL_AddMessage( "VOCAL_PETRO_Petro_WrongFire" , "&Petro_WrongFire" , x , y );
		
	}
	
	else if ( ( FireAgent == 1 ) && ( FireType == 0 ) )
	{
		PNL_AddMessage( "VOCAL_PETRO_Petro_WrongFire2" , "&Petro_WrongFire2" , x , y );
	}


}

////////////////////////////end atack nepravilnie ogni


