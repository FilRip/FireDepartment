void Duseldorf_StartScenar()
{
	SCR_SetVarS32("ScenarTrans", 0);
	SCR_SetVarS32("ReinforcementsGranted", 0);
	//
}
//END

void Duseldorf_CheckScenar()
{
	
	s32 tmp;

	tmp = SCR_GetVarS32("ScenarTrans");
	if(tmp == 0)
	{
		CheckScenario0();
	}
	if(tmp == 666)
	{
		Defeat();
	}
	if(tmp == 999)
	{
		Victory();
	}
}
//END



