{
	f32 TotalIntensity, TotalLife;
	s32 i, NbUnit;
	
	//lose conditions
	if(LEV_GetNumVictims() >= SCR_GetVarS32("MaxDeadCivil"))
	{
		SCR_SetVarS32("ScenarTrans", 666);
		SCR_SetVarString("DebriefText", "&CommonDefeatCivil");
	}
	
	// if( (LEV_GetFireSizePercent() > 0.75) && (LEV_GetDifficultyLevel() == 2) )
