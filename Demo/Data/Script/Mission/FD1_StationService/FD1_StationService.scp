// l'ingénieur prend le camion-citerne (il le « répare ») : le camion du décor laisse la place au véhicule à conduire ;
// le feu du camion part avec lui
void Use_Citerne(EntityID User, EntityID Bouton, mcString State)
{
	if(SCR_GetVarS32("Conduite") == 1)
		return;
	SCR_SetVarS32("Conduite", 1);
	SCR_SetVarS32("Arrosage", 1);
	Eteint(SCR_GetVarS32("G_0"));
	ENT_SetVisibility(ENT_FindByName("Citerne"), 0);
	ENT_SetVisibility(ENT_FindByName("CiterneGPL"), 1);
}
// le camion-citerne entre dans l'unité d'arrosage à mousse (FD1 : Trigger_truckrescue) : 5 s d'arrosage
void TriggerTruck(EntityID Unit, EntityID Zone)
{
	if(Unit != ENT_FindByName("CiterneGPL") || SCR_GetVarS32("Arrose") != 0)
		return;
	SCR_SetVarS32("Arrose", 1);
	if(SCR_GetVarS32("G_21") != 0)
		FIR_HPSetSprinkler(SCR_GetVarS32("G_21"), 10.0);
	SCR_RunDelayed("ApplySprinkler", 5.0);
}
// fin de l'arrosage (FD1 : ApplySprinkler) : le camion est hors de danger
void ApplySprinkler()
{
	if(SCR_GetVarS32("G_21") != 0)
		FIR_HPSetSprinkler(SCR_GetVarS32("G_21"), 0.0);
	Eteint(SCR_GetVarS32("G_0"));
	SCR_SetVarS32("CamionSauve", 1);
	if(SCR_GetVarS32("Acte") == 1)
		Station_Acte2();
}
// la vanne de la supérette (FD1 : ValveEssence) : les pompes et la fuite de propane s'éteignent
void ValveEssence()
{
	if(SCR_GetVarS32("ValveDone") == 1)
		return;
	SCR_SetVarS32("ValveDone", 1);
	Eteint(SCR_GetVarS32("G_1"));
	Eteint(SCR_GetVarS32("G_20"));
	Cine_VALVE();
}
// la fuite de propane se rallume toutes les 10 s tant que la vanne est ouverte (FD1 : JetFlamme)
void JetFlamme()
{
	if(SCR_GetVarS32("ValveDone") == 1)
		return;
	Allume(SCR_GetVarS32("G_20"), SCR_GetVarS32("G_20"));
	SCR_RunDelayed("JetFlamme", 10.0);
}

// acte 2 (FD1 : Scenario1 réussi) : la supérette prend feu
void Station_Acte2()
{
	SCR_SetVarS32("Acte", 2);
	LEV_ValidateObjective(SCR_GetVarS32("Obj_Acte1"), 1);
	Montre("Caissiere");
	Montre("Patron");
	Montre("Client");
	Allume(SCR_GetVarS32("G_2"), SCR_GetVarS32("A_2"));
	JetFlamme();
	Cine_SUPERETTE();
	LEV_RoofVisibility("fd1_sta_station_service_toit_0_385_ROOF", 0);
	SCR_SetVarS32("Obj_Acte2", LEV_AddObjectiveIterate("&FD1_StationService_STATION_DES_S2O0", 6));
}
// acte 3 (FD1 : Scenario2 réussi) : le chantier prend feu
void Station_Acte3()
{
	SCR_SetVarS32("Acte", 3);
	LEV_ValidateObjective(SCR_GetVarS32("Obj_Acte2"), 1);
	Allume(SCR_GetVarS32("G_3"), SCR_GetVarS32("A_3"));
	Cine_REFECTION();
	LEV_RoofVisibility("fd1_sta_station_maison_abandonnee_toit_0_110_ROOF", 0);
	SCR_SetVarS32("Obj_Acte3", LEV_AddObjectiveIterate("&FD1_StationService_STATION_DES_S3O0", 3));
}
// acte 4 (FD1 : Scenario3 réussi) : la cour de la station s'éteint d'elle-même, une voiture embrase l'immeuble ouest
void Station_Acte4()
{
	SCR_SetVarS32("Acte", 4);
	LEV_ValidateObjective(SCR_GetVarS32("Obj_Acte3"), 1);
	if(SCR_GetVarS32("G_8") != 0)
		FIR_HPSetGrowthRate(SCR_GetVarS32("G_8"), -2.0);
	SCR_RunDelayed("ExplVoiture", 1.0);
	SCR_RunDelayed("EtageCut", 2.0);
	Montre("Hab2");
	Allume(SCR_GetVarS32("G_7"), 0);
	LEV_RoofVisibility("fd1_sta_habitat_toit_0_56_ROOF", 0);
	SCR_SetVarS32("Obj_Habitants", LEV_AddObjectiveIterate("&FD1_StationService_STATION_DES_S4O0", 5));
	SCR_SetVarS32("Obj_Voleur", LEV_AddObjectiveBoolean("&FD1_StationService_STATION_DES_S4O1"));
	SCR_SetVarS32("Obj_Sac", LEV_AddObjectiveBoolean("&FD1_StationService_STATION_DES_S4O2"));
	if(SCR_GetVarS32("SacOK") == 1)
		LEV_ValidateObjective(SCR_GetVarS32("Obj_Sac"), 1);
	if(SCR_GetVarS32("Sauve_Voleur") == 1)
		LEV_ValidateObjective(SCR_GetVarS32("Obj_Voleur"), 1);
}
void ExplVoiture()
{
	ENT_SetDamage(ENT_FindByName("VoitActe4"), 0.0);
	Allume(SCR_GetVarS32("G_4"), SCR_GetVarS32("A_4"));
}
// la cinématique de l'immeuble, puis l'échelle et le bras élévateur arrivent (FD1 : EtageCut, ArriveeMega)
void EtageCut()
{
	Cine_ETAGE();
	SCR_RunDelayed("Renfort", 9.0);
}
void Renfort()
{
	LEV_CallReinforcement(1);
}

s32 Cassee(mcString porte)
{
	if(ENT_GetState(ENT_FindByName(porte)) == "Broken")
		return 1;
	return 0;
}
void Back1Cut()
{
	Cine_BACK1();
}
void Back2Cut()
{
	Cine_BACK2();
}
// portes cassées (à partir de l'acte 3, FD1 : CheckGlobalCache) : victimes découvertes, backdrafts
void Station_Portes()
{
	if(SCR_GetVarS32("Cache1") == 0 && Cassee("Porte6") == 1)
	{
		SCR_SetVarS32("Cache1", 1);
		Montre("Ouvrier1");
	}
	if(SCR_GetVarS32("Cache1") == 0 && Cassee("Porte4") == 1)
	{
		SCR_SetVarS32("Cache1", 1);
		ENT_SetDamage(ENT_FindByName("Back1"), 0.0);
		SCR_RunDelayed("Back1Cut", 1.0);
		Montre("Ouvrier1");
	}
	if(Cassee("Porte3") == 1)
		Montre("Ouvrier3");
	if(Cassee("Porte5") == 1 || Cassee("Porte7") == 1 || Cassee("Porte8") == 1)
		Montre("Ouvrier0");
	if(Cassee("Porte9") == 1)
	{
		Montre("Hab3");
		Montre("Hab4");
	}
	if(SCR_GetVarS32("Cache14") == 0 && (Cassee("Porte12") == 1 || Cassee("Porte13") == 1 || Cassee("Porte14") == 1))
	{
		SCR_SetVarS32("Cache14", 1);
		Allume(SCR_GetVarS32("G_5"), SCR_GetVarS32("A_5"));
		ENT_SetDamage(ENT_FindByName("Back2"), 0.0);
		ENT_SetDamage(ENT_FindByName("Back3"), 0.0);
		ENT_SetDamage(ENT_FindByName("Back4"), 0.0);
		SCR_RunDelayed("Back2Cut", 1.0);
	}
	if(Cassee("Porte13") == 1 || Cassee("Porte14") == 1)
		Montre("Hab1");
	if(Cassee("Porte15") == 1)
	{
		Montre("Poligote");
		Montre("Voleur");
	}
}
// zones FD1 qui découvrent une pièce (TCache3, 5, 11, 17, 19) ; la réserve de peinture (TCache4)
void TCache3(EntityID Unit, EntityID Zone)
{
	if(SCR_GetVarS32("Acte") < 3)
		return;
	Montre("Ouvrier3");
}
void TCache5(EntityID Unit, EntityID Zone)
{
	if(SCR_GetVarS32("Acte") < 3)
		return;
	Montre("Ouvrier0");
}
void TCache11(EntityID Unit, EntityID Zone)
{
	if(SCR_GetVarS32("Acte") < 4)
		return;
	Montre("Hab1");
}
void TCache17(EntityID Unit, EntityID Zone)
{
	if(SCR_GetVarS32("Acte") < 4)
		return;
	Montre("Poligote");
}
void TCache19(EntityID Unit, EntityID Zone)
{
	if(SCR_GetVarS32("Acte") < 4)
		return;
	Montre("Voleur");
}
void TCache4(EntityID Unit, EntityID Zone)
{
	if(SCR_GetVarS32("PeintureVue") == 1 || Feu(SCR_GetVarS32("G_Peinture")) <= 1.0)
		return;
	SCR_SetVarS32("PeintureVue", 1);
	Cine_PEINTURE();
}

// la citerne de butane détruite par le feu (FD1 : CheckBombonne) : deux policiers soufflés, la rue prend feu
void BombonneExplosee(EntityID Bombonne)
{
	SCR_SetVarS32("BombonneExp", 1);
	Montre("PolicierEvanoui");
	Montre("PolicierEvanoui2");
	Allume(SCR_GetVarS32("G_6"), SCR_GetVarS32("A_6"));
	Cine_BOMBONNE();
}
// le sac des 3 millions (FD1 : OnPickMe)
void Pick_Sac()
{
	if(SCR_GetVarS32("SacOK") == 1 || SCR_GetVarS32("SacBrule") == 1)
		return;
	SCR_SetVarS32("SacOK", 1);
	ENT_SetVisibility(ENT_FindByName("Sac"), 0);
	PNL_AddMessage("", "&FD1_StationService_EVENT_STA_BUTIN", 0.0, 0.0);
	if(SCR_GetVarS32("Acte") == 4)
		LEV_ValidateObjective(SCR_GetVarS32("Obj_Sac"), 1);
}
// civil mis à l'abri (rappel du moteur)
void OnCivilianSaved(EntityID Civil)
{
	if(Civil == ENT_FindByName("Client"))
		SCR_SetVarS32("Sauve_Client", 1);
	if(Civil == ENT_FindByName("Policier"))
		SCR_SetVarS32("Sauve_Policier", 1);
	if(Civil == ENT_FindByName("Citernedriver"))
		SCR_SetVarS32("Sauve_Citernedriver", 1);
	if(Civil == ENT_FindByName("Otage1"))
		SCR_SetVarS32("Sauve_Otage1", 1);
	if(Civil == ENT_FindByName("Caissiere"))
		SCR_SetVarS32("Sauve_Caissiere", 1);
	if(Civil == ENT_FindByName("Patron"))
		SCR_SetVarS32("Sauve_Patron", 1);
	if(Civil == ENT_FindByName("Ouvrier0"))
		SCR_SetVarS32("Sauve_Ouvrier0", 1);
	if(Civil == ENT_FindByName("Ouvrier1"))
		SCR_SetVarS32("Sauve_Ouvrier1", 1);
	if(Civil == ENT_FindByName("Ouvrier3"))
		SCR_SetVarS32("Sauve_Ouvrier3", 1);
	if(Civil == ENT_FindByName("Hab1"))
		SCR_SetVarS32("Sauve_Hab1", 1);
	if(Civil == ENT_FindByName("Hab2"))
		SCR_SetVarS32("Sauve_Hab2", 1);
	if(Civil == ENT_FindByName("Hab3"))
		SCR_SetVarS32("Sauve_Hab3", 1);
	if(Civil == ENT_FindByName("Hab4"))
		SCR_SetVarS32("Sauve_Hab4", 1);
	if(Civil == ENT_FindByName("Poligote"))
		SCR_SetVarS32("Sauve_Poligote", 1);
	if(Civil == ENT_FindByName("Voleur"))
		SCR_SetVarS32("Sauve_Voleur", 1);
	if(Civil == ENT_FindByName("Voleur"))
	{
		PNL_AddMessage("", "&FD1_StationService_EVENT_STA_GANGSTER", 0.0, 0.0);
		if(SCR_GetVarS32("Acte") == 4)
			LEV_ValidateObjective(SCR_GetVarS32("Obj_Voleur"), 1);
	}
}
void Station_Defaite()
{
	LEV_TriggerDefeat();
}
// victoire (FD1 : Victory_OnTimer) : le sac sauvé ou non
void Station_Victoire()
{
	LEV_ValidateObjective(SCR_GetVarS32("Obj_Habitants"), 1);
	if(SCR_GetVarS32("SacOK") == 1)
		LEV_SetDebriefText("&FD1_StationService_VICTORY1");
	else
		LEV_SetDebriefText("&FD1_StationService_VICTORY2");
	LEV_TriggerVictory();
}

// boucle : défaites, citerne de butane, sac, portes, victimes de l'acte en cours
void Station_Main()
{
	s32 n;
	if(SCR_GetVarS32("Fin") != 0)
		return;
	if(LEV_IsHealVehicleRemaining() == 0)
	{
		SCR_SetVarS32("Fin", 2);
		LEV_SetDebriefText("&FD1_StationService_DEFEAT4");
		SCR_RunDelayed("Station_Defaite", 5.0);
		return;
	}
	if(SCR_GetVarS32("Conduite") == 0 && ENT_GetDamage(ENT_FindByName("Citerne")) <= 0.0)
	{
		SCR_SetVarS32("Fin", 2);
		LEV_SetDebriefText("&FD1_StationService_DEFEAT1");
		SCR_RunDelayed("Station_Defaite", 5.0);
		return;
	}
	if(SCR_GetVarS32("Conduite") == 1 && SCR_GetVarS32("CamionSauve") == 0 && ENT_GetUnitState(ENT_FindByName("CiterneGPL")) == 4)
	{
		SCR_SetVarS32("Fin", 2);
		LEV_SetDebriefText("&FD1_StationService_DEFEAT1");
		SCR_RunDelayed("Station_Defaite", 5.0);
		return;
	}
	if(SCR_GetVarS32("Conduite") == 0 && Feu(SCR_GetVarS32("G_0")) > 0.0)
		SCR_SetVarS32("CiterneChaleur", SCR_GetVarS32("CiterneChaleur") + 1);
	if(SCR_GetVarS32("CiterneChaleur") >= 1200)
	{
		ENT_SetDamage(ENT_FindByName("Citerne"), 0.0);
		SCR_SetVarS32("Fin", 2);
		LEV_SetDebriefText("&FD1_StationService_DEFEAT1");
		SCR_RunDelayed("Station_Defaite", 5.0);
		return;
	}
	if(SCR_GetVarS32("SacOK") == 0 && Feu(SCR_GetVarS32("G_Sac")) > 0.0)
		SCR_SetVarS32("SacChaleur", SCR_GetVarS32("SacChaleur") + 1);
	if(SCR_GetVarS32("SacOK") == 0 && SCR_GetVarS32("SacChaleur") >= 300)
	{
		SCR_SetVarS32("SacBrule", 1);
		ENT_SetVisibility(ENT_FindByName("Sac"), 0);
		if(SCR_GetVarS32("Acte") == 4)
			LEV_ValidateObjective(SCR_GetVarS32("Obj_Sac"), 0);
		SCR_SetVarS32("Fin", 2);
		LEV_SetDebriefText("&FD1_StationService_DEFEAT7");
		SCR_RunDelayed("Station_Defaite", 5.0);
		return;
	}
	if(SCR_GetVarS32("BombonneDanger") == 0 && SCR_GetVarS32("BombonneExp") == 0 && ENT_GetDamage(ENT_FindByName("Bombonne")) < 99.0)
	{
		SCR_SetVarS32("BombonneDanger", 1);
		Cine_BOMBONNEDANGER();
	}
	if(Feu(SCR_GetVarS32("G_0")) > 0.0)
		SCR_SetVarS32("CamionEnFeu", 1);
	if(SCR_GetVarS32("Arrosage") == 0 && SCR_GetVarS32("CamionEnFeu") == 1 && Feu(SCR_GetVarS32("G_0")) <= 0.0)
	{
		SCR_SetVarS32("Arrosage", 1);
		Cine_ARROSAGE();
	}
	if(SCR_GetVarS32("Acte") >= 3)
		Station_Portes();
	if(SCR_GetVarS32("Acte") == 2)
	{
		n = SCR_GetVarS32("Sauve_Client") + SCR_GetVarS32("Sauve_Policier") + SCR_GetVarS32("Sauve_Citernedriver") + SCR_GetVarS32("Sauve_Otage1") + SCR_GetVarS32("Sauve_Caissiere") + SCR_GetVarS32("Sauve_Patron");
		LEV_UpdateObjective(SCR_GetVarS32("Obj_Acte2"), n);
		if(n >= 6)
			Station_Acte3();
		return;
	}
	if(SCR_GetVarS32("Acte") == 3)
	{
		n = SCR_GetVarS32("Sauve_Ouvrier0") + SCR_GetVarS32("Sauve_Ouvrier1") + SCR_GetVarS32("Sauve_Ouvrier3");
		LEV_UpdateObjective(SCR_GetVarS32("Obj_Acte3"), n);
		if(n >= 3)
			Station_Acte4();
		return;
	}
	if(SCR_GetVarS32("Acte") == 4)
	{
		n = SCR_GetVarS32("Sauve_Hab1") + SCR_GetVarS32("Sauve_Hab2") + SCR_GetVarS32("Sauve_Hab3") + SCR_GetVarS32("Sauve_Hab4") + SCR_GetVarS32("Sauve_Poligote");
		LEV_UpdateObjective(SCR_GetVarS32("Obj_Habitants"), n);
		if(n >= 5 && SCR_GetVarS32("Sauve_Voleur") == 1)
		{
			SCR_SetVarS32("Fin", 1);
			SCR_RunDelayed("Station_Victoire", 5.0);
		}
	}
}

void FD1_StationService_Start()
{
	Station_Init();
}

void FD1_StationService_Main()
{
	Station_Main();
}
