// Sac : appelle Pick_Sac
void Use_Sac(EntityID User, EntityID Bouton, mcString State)
{
	if(SCR_GetVarS32("Sac") == 0)
	{
		SCR_SetVarS32("Sac", 1);
		SCR_SetVarS32("User_Sac", User);
		Pick_Sac();
		ENT_SetCapacityTarget(Bouton, "CouldBeUse", 0);
	}
}

// valveessence : appelle ValveEssence
void Use_valveessence(EntityID User, EntityID Bouton, mcString State)
{
	if(SCR_GetVarS32("valveessence") == 0)
	{
		SCR_SetVarS32("valveessence", 1);
		SCR_SetVarS32("User_valveessence", User);
		ValveEssence();
		ENT_SetCapacityTarget(Bouton, "CouldBeUse", 0);
	}
}

// ===== Station-service : déroulement (traduit des scripts FD1) =====

// un groupe de foyers FD1 prend feu (SetHotpointGroupActivated(n, 1)) : il peut brûler, les foyers de a prennent
void Allume(s32 g, s32 a)
{
	if(g != 0)
		FIR_HPEnable(g, 1);
	if(a != 0)
		FIR_HPSetIntensity(a, 20.0);
}
// un groupe s'éteint et ne peut plus brûler (SetHotpointGroupActivated(n, 0))
void Eteint(s32 g)
{
	if(g == 0)
		return;
	FIR_HPSetIntensity(g, 0.0);
	FIR_HPEnable(g, 0);
}
// intensité d'un groupe (0 s'il n'a aucun foyer)
f32 Feu(s32 g)
{
	if(g == 0)
		return 0.0;
	return FIR_HPGetIntensity(g);
}
// une victime paraît (une seule fois : une victime sauvée ne revient pas)
void Montre(mcString nom)
{
	if(SCR_GetVarS32("Vu_" + nom) == 1)
		return;
	SCR_SetVarS32("Vu_" + nom, 1);
	ENT_SetVisibility(ENT_FindByName(nom), 1);
}

