// FD1_StationService : mission convertie de Fire Department 1 (station_service)

// ===== cinématiques FD1 (.ccs) =====
void Cine_VALVE()
{
	if(SCR_GetVarS32("CineEnCours") == 1)
		return;
	SCR_SetVarS32("CineEnCours", 1);
	CAM_Cinematic(1);
	CAM_SetInertia(1.0);
	LEV_RoofVisibility("fd1_sta_station_service_toit_0_385_ROOF", 0);
	LEV_RoofVisibility("fd1_lid_sta_station_service_partie02_4_ROOF", 0);
	CAM_TeleportToWayPoint(ENT_FindByName("cine_VALVE_0"));
	PNL_PrintSubtitle("&FD1_StationService_STA_CUT_VALVE");
	CAM_CinematicSetToWayPoint(ENT_FindByName("cine_VALVE_1"), 1.5);
	SCR_RunDelayed("Cine_VALVE_1", 1.5);
	SCR_RunDelayed("Cine_VALVE_Fin", 4.5);
}
void Cine_VALVE_1()
{
}
void Cine_VALVE_Fin()
{
	PNL_ClearSubtitle();
	CAM_ModePlay();
	SCR_SetVarS32("CineEnCours", 0);
}

