<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Lecture des vidéos du jeu (Data\Video\*.bik, format Bink) : décodeur natif « openfdvideo » (FFmpeg minimal, LGPL),
    une bibliothèque par système dans runtimes\<système>\native. Pour porter le jeu sur un autre système, il suffit
    de compiler native\OpenFDvideo pour lui (voir native\OpenFDvideo\LISEZMOI.md) : le code C# ne change pas.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <None Include="runtimes\win-x64\native\openfdvideo.dll" Link="openfdvideo.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('runtimes\win-x64\native\openfdvideo.dll')" />
    <None Include="runtimes\linux-x64\native\libopenfdvideo.so" Link="libopenfdvideo.so" CopyToOutputDirectory="PreserveNewest" Condition="Exists('runtimes\linux-x64\native\libopenfdvideo.so')" />
    <None Include="runtimes\osx-x64\native\libopenfdvideo.dylib" Link="libopenfdvideo.dylib" CopyToOutputDirectory="PreserveNewest" Condition="Exists('runtimes\osx-x64\native\libopenfdvideo.dylib')" />
  </ItemGroup>
</Project>
