<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Multijoueur : liaison UDP (port 27999) fiable et ordonnée, salon (joueurs prêts, mission choisie), et partie en
    « pas à pas commun » : la simulation est déterministe, seuls les ordres des joueurs voyagent ; le serveur leur donne
    le numéro du pas de simulation où tout le monde les appliquera. Sans dépendance au moteur graphique.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
